GROQ_API_KEY=your_groq_api_key_here
# One default model for everything. Leave as is unless you want to try another Groq model.
GROQ_MODEL=llama-3.3-70b-versatile
FRONTEND_ORIGIN=http://127.0.0.1:5000
# REQUIRED in production (32+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Production persistence (Phase 1 fixes) — leave both blank for local dev,
# the app falls back to local SQLite + in-memory rate limiting automatically.
# DATABASE_URL: attach a Postgres instance (Render/Neon/Supabase all have a
#   free tier) so user/run data survives redeploys instead of living on the
#   free-tier's ephemeral disk.
# REDIS_URL: attach Redis (Render/Upstash free tier) so rate limits are
#   shared across all gunicorn workers instead of counted per-worker.
DATABASE_URL=
REDIS_URL=

# Billing (Phase 3) — leave blank locally if you're not testing payments yet.
# Get test-mode keys from the Razorpay dashboard (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PRICE_INR=199
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
OTP_DEV_MODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
ADMIN_EMAILS=
RECRUITER_EMAILS=
PORT=5000
